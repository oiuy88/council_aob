```yaml
name: Update Consilium AOB RSS

on:
  schedule:
    # Run every 15 minutes
    - cron: "*/15 * * * *"

  # Allows you to run it manually from GitHub
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update-feed:

    runs-on: ubuntu-latest

    steps:

      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.x"

      - name: Generate AOB feed
        run: |
          python filter_rss.py

      - name: Commit updated feed
        run: |

          git config user.name \
            "github-actions[bot]"

          git config user.email \
            "41898282+github-actions[bot]@users.noreply.github.com"

          git add aob.xml

          if git diff --cached --quiet; then
            echo "No changes."
          else
            git commit -m "Update AOB RSS"
            git push
          fi
```
